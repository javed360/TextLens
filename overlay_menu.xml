<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_menu_pill"
    android:orientation="horizontal"
    android:padding="6dp">

    <ImageButton
        android:id="@+id/btn_pen"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/menu_pen"
        android:src="@drawable/ic_pen" />

    <ImageButton
        android:id="@+id/btn_box"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/menu_box"
        android:src="@drawable/ic_box" />

    <ImageButton
        android:id="@+id/btn_camera"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/menu_camera"
        android:src="@drawable/ic_camera" />
</LinearLayout>
